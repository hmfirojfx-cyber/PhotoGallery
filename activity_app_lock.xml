<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter App PIN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter PIN / Password"
        android:inputType="textPassword"
        android:maxLength="20"
        android:padding="14dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/layoutConfirmPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etConfirmPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm PIN / Password"
            android:inputType="textPassword"
            android:maxLength="20"
            android:padding="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unlock"
        android:padding="12dp"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnBiometric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        text="Use Fingerprint / Biometric"
        android:text="Use Fingerprint"
        android:padding="12dp"
        android:backgroundTint="@android:color/darker_gray"
        android:textColor="@android:color/white"/>

</LinearLayout>